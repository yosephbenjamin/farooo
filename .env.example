# Required for ingest and live lookups. Never commit a real key.
CALA_API_KEY=
# Optional: LLM "why you" fit sentences and claim extraction. Falls back to a heuristic.
ANTHROPIC_API_KEY=
# Optional: send alert emails. Without it, /log shows alerts as emails.
RESEND_API_KEY=
ALERT_FROM=faro@example.com
ALERT_TO=
# Set to 1 to never call Cala (serve from data/ and the on-disk cache only).
CALA_OFFLINE=
# Node's fetch needs this behind an HTTPS proxy (Node >= 22.21).
# NODE_USE_ENV_PROXY=1
