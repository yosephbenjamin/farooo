{
  "timeZone": "Europe/Helsinki",
  "runtimeVersion": "V8",
  "oauthScopes": [
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.addons.current.message.metadata",
    "https://www.googleapis.com/auth/userinfo.email",
    "https://www.googleapis.com/auth/script.external_request",
    "https://www.googleapis.com/auth/script.storage"
  ],
  "urlFetchWhitelist": ["https://"],
  "addOns": {
    "common": {
      "name": "Faro",
      "logoUrl": "https://raw.githubusercontent.com/yosephbenjamin/farooo/main/gmail-addon/lighthouse.png",
      "homepageTrigger": { "runFunction": "onHomepage" }
    },
    "gmail": {
      "contextualTriggers": [{ "unconditional": {}, "onTriggerFunction": "onGmailMessage" }]
    }
  }
}
